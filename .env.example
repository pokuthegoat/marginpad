# Copy to .env.local for development (git-ignored). On Vercel, set these in Project Settings > Environment Variables.
#
# VITE_* values are PUBLIC: they are shipped to every browser. Only public identifiers go under that prefix.
# NEVER put a private key, deployer key, or any secret in a VITE_ variable.

# Privy App ID (public). Without it the site shows a placeholder wallet button.
VITE_PRIVY_APP_ID=

# Network the app talks to. REQUIRED for production builds: 46630 (Robinhood Chain Testnet). There is no default.
# In development it defaults to Local Anvil (31337) when unset. Mainnet is not supported.
VITE_CHAIN_ID=46630

# Optional: replace the public testnet RPC with a provider URL (must be https in production). Leave empty to use the default.
VITE_RPC_URL=

# Optional: replace the public Robinhood Chain MAINNET RPC used for READ-ONLY Pons discovery (https). No transaction is ever sent there.
VITE_PONS_RPC_URL=

# --- Accounts (SERVER-ONLY: no VITE_ prefix, so the browser build never sees these) ---
# Privy App Secret (from dashboard.privy.io). On Vercel, set it in Project Settings > Environment Variables.
PRIVY_APP_SECRET=
# Production database (Turso). Leave empty in development: a local file at data/marginpad.db is used instead.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Optional: a different local database file for development.
MARGINPAD_DB_PATH=

# Mainnet (real funds) is OFF unless BOTH VITE_CHAIN_ID=4663 and VITE_ALLOW_MAINNET=true are set. Do not enable it for real
# users: the contracts are unaudited. Leave this empty for testnet and local builds.
VITE_ALLOW_MAINNET=
