# Copy to contracts/.env (git-ignored). Foundry loads it automatically when run from contracts/.
#
# ---- LOCAL (anvil) ------------------------------------------------------------------------------------------
# Anvil's first account. Its key is PUBLISHED in Foundry's docs, so it is safe for a local chain and must NEVER be
# used anywhere else. The deploy script refuses it on any public chain.
PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# ---- ROBINHOOD CHAIN TESTNET ---------------------------------------------------------------------------------
# Use a NEW throwaway wallet that only ever holds testnet ETH:   cast wallet new
# Put its private key above instead of the Anvil one, and fund its address from the testnet faucet.
# Never put a key that holds real funds in this file.
#
# The public RPC in foundry.toml is rate-limited. For heavier use, set a provider URL (Alchemy, QuickNode, ...) and
# pass it with --rpc-url $ROBINHOOD_TESTNET_RPC_URL.
# ROBINHOOD_TESTNET_RPC_URL=

# ---- OPTIONAL ------------------------------------------------------------------------------------------------
# Final owner of all three contracts (default: the deployer). Ownership moves in two steps: this address must call
# acceptOwnership() on each contract afterwards.
# OWNER=
# Price oracle address (default: none yet; set later with RiskManager.setOracle).
# ORACLE=
# Testnet settlement reserve funded at deploy, in wei (default 1 ether), and oracle max price age in seconds (default 1 day).
# RESERVE_ETH=1000000000000000000
# MAX_PRICE_AGE=86400
# Set to false to skip writing deployments/<chainId>.json
# WRITE_DEPLOYMENT=true

# ---- PRODUCTION SETTINGS (all optional; defaults are chosen per chain, see script/Deploy.s.sol) ------------------
# ORACLE_UPDATER=      keeper key ADDRESS allowed to push prices (required on mainnet; must differ from deployer and owner)
# MAX_PRICE_AGE=       seconds; mainnet default 120
# MAX_MOVE_BPS=        largest single oracle update, in bps; mainnet default 1000 (10%)
# MIN_HOLD_SECONDS=    minimum time before an owner may close a position; mainnet default 300
# CONFIRM_MAINNET=     chain 4663 only: must equal I_UNDERSTAND_THIS_USES_REAL_FUNDS (nothing deploys to mainnet without it)
